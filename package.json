{
  "name": "@a1/pricing-engine",
  "version": "1.1.0",
  "description": "Single source of truth for A1 Marine pricing — Marine Care detailing/coatings + Marine Storage. Consumed by both a1marinecare.ca and a1marinestorage.ca.",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src/pricing.config.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/pricing.config.json','dist/pricing.config.json')\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
